# Arcade Hub — multiplayer server environment (copy to .env or paste into Render dashboard)

# Port Render sets this automatically; 3001 is for local testing.
PORT=3001

# Comma-separated list of allowed origins, or * for open (recommended: your GitHub Pages origin)
ALLOWED_ORIGINS=https://bittuhere.github.io

# OPTIONAL BUT STRONGLY RECOMMENDED — Firebase service account JSON as a SINGLE LINE.
# Firebase console → Project Settings → Service accounts → Generate new private key.
# Paste the entire JSON (with newlines removed is fine — JSON.parse handles escaped \n).
# Enables: verified ID tokens on every socket connection + FCM push invites to offline players.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project", ...}
